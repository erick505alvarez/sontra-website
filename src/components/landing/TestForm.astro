---
import { Phone } from "@lucide/astro";
---

<section class="text-center">
  <h2 class="text-2xl md:text-3xl font-heading font-semibold mb-8">
    Test it for yourself...
  </h2>
  <form
    class="flex flex-col lg:flex-row gap-4 mx-auto border border-primary rounded-lg bg-primary/5 p-10">
    <input
      type="text"
      name="first_name"
      placeholder="First Name"
      class="test-form-input flex-1 border border-gray-300 rounded-lg px-4 py-3 text-base"
    />
    <input
      type="email"
      name="email"
      placeholder="Email"
      class="test-form-input flex-1 border border-gray-300 rounded-lg px-4 py-3 text-base"
    />
    <input
      type="tel"
      name="phone"
      placeholder="19995554321"
      class="test-form-input flex-1 border border-gray-300 rounded-lg px-4 py-3 text-base"
    />
    <button
      type="button"
      class="inline-flex items-center justify-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-semibold whitespace-nowrap hover:bg-primary/90 transition-colors">
      Test A.I. Voice Agent
      <Phone class="w-5 h-5" />
    </button>
  </form>
</section>
