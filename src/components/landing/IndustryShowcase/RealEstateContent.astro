---
import { CheckCircle2 } from "@lucide/astro";

const benefits = [
  "Answer every call 24/7, capturing leads even when agents are unavailable.",
  "Schedule property viewings automatically, syncing directly with agents' calendars.",
  "Instantly provide detailed property information to callers using your current listings.",
];

const properties = [
  {
    address: "831 Etna Street, New York, NY",
    type: "House in East New York",
    beds: "5bd",
    baths: "2ba",
    sqft: "1,960ft²",
    budget: "$899,999",
    contact: {
      initials: "AB",
      name: "Annette Black",
      phone: "(308) 555-0121",
      email: "l.chaney@gmail.com",
    },
  },
  {
    address: "8513 E. Pecan St. Tuleta, TX",
    type: "House in Tuleta",
    beds: "7bd",
    baths: "3ba",
    sqft: "1,710ft²",
    budget: "$559,000",
    contact: {
      initials: "DS",
      name: "Darrell Steward",
      phone: "(702) 555-0122",
      email: "darrell.stew@gmail.com",
    },
  },
  {
    address: "8080 Railroad Ave, Palermo, CA",
    type: "House in Palermo",
    beds: "",
    baths: "",
    sqft: "",
    budget: "$625,000",
    contact: null,
  },
];
---

<section class="max-w-7xl mx-auto px-4 py-12">
  <div class="grid lg:grid-cols-2 gap-12 items-start">
    <!-- Left Column - Benefits -->
    <div>
      <h2
        class="text-4xl md:text-5xl font-heading font-bold text-gray-900 mb-8">
        Real Estate
      </h2>

      <div class="space-y-4 mb-8">
        {
          benefits.map((benefit) => (
            <div class="flex gap-3 items-start">
              <CheckCircle2 class="w-6 h-6 text-primary flex-shrink-0 mt-0.5" />
              <p class="text-lg text-gray-700 leading-relaxed">{benefit}</p>
            </div>
          ))
        }
      </div>

      <a
        href="/booking"
        class="inline-flex items-center gap-2 bg-white text-gray-900 px-6 py-3 rounded-lg font-semibold border-2 border-gray-900 hover:bg-gray-50 transition-colors">
        Get started today →
      </a>
    </div>

    <!-- Right Column - Property Listings -->
    <div class="space-y-4">
      {
        properties.map((property) => (
          <div class="bg-white rounded-xl border border-gray-200 p-6 shadow-sm">
            <div class="flex justify-between items-start mb-3">
              <div>
                <h3 class="font-semibold text-gray-900 text-lg mb-1">
                  {property.address}
                </h3>
                <p class="text-sm text-gray-500">{property.type}</p>
              </div>
              <div class="text-right">
                <div class="text-xs text-gray-500 mb-1">Budget</div>
                <div class="font-semibold text-gray-900">{property.budget}</div>
              </div>
            </div>

            {property.beds && (
              <div class="flex items-center gap-4 text-sm text-gray-600 mb-4">
                <span class="flex items-center gap-1">🏠 {property.beds}</span>
                <span class="flex items-center gap-1">🛁 {property.baths}</span>
                <span class="flex items-center gap-1">📏 {property.sqft}</span>
              </div>
            )}

            {property.contact && (
              <div class="pt-4 border-t border-gray-200">
                <div class="flex items-center gap-3">
                  <div class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center font-semibold text-gray-700 text-sm">
                    {property.contact.initials}
                  </div>
                  <div class="flex-1">
                    <div class="font-semibold text-gray-900 text-sm">
                      {property.contact.name}
                    </div>
                    <div class="text-xs text-gray-500">
                      📞 {property.contact.phone} • {property.contact.email}
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
        ))
      }
    </div>
  </div>
</section>
