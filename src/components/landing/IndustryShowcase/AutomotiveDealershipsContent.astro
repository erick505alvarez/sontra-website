---
import { CheckCircle2 } from "@lucide/astro";

const benefits = [
  "Convert after-hours inquiries into scheduled appointments and qualified leads.",
  "Provide instant vehicle availability, pricing, and financing information around the clock.",
  "Schedule test drives and service appointments while capturing customer preferences.",
];
---

<section class="max-w-7xl mx-auto px-4 py-12">
  <div class="grid lg:grid-cols-2 gap-12 items-start">
    <!-- Left Column - Benefits -->
    <div>
      <h2
        class="text-4xl md:text-5xl font-heading font-bold text-gray-900 mb-8">
        Automotive Dealerships
      </h2>

      <div class="space-y-4 mb-8">
        {
          benefits.map((benefit) => (
            <div class="flex gap-3 items-start">
              <CheckCircle2 class="w-6 h-6 text-primary flex-shrink-0 mt-0.5" />
              <p class="text-lg text-gray-700 leading-relaxed">{benefit}</p>
            </div>
          ))
        }
      </div>

      <a
        href="/booking"
        class="inline-flex items-center gap-2 bg-white text-gray-900 px-6 py-3 rounded-lg font-semibold border-2 border-gray-900 hover:bg-gray-50 transition-colors">
        Get started today →
      </a>
    </div>

    <!-- Right Column - Chat Conversation -->
    <div
      class="bg-white rounded-2xl border border-gray-200 p-6 shadow-sm space-y-4">
      <!-- Customer Message -->
      <div class="flex items-start gap-3">
        <div
          class="w-10 h-10 rounded-full bg-gray-200 flex items-center justify-center flex-shrink-0">
          <span class="text-sm">👤</span>
        </div>
        <div class="flex-1 bg-gray-50 rounded-2xl rounded-tl-sm p-4">
          <p class="text-sm text-gray-800 leading-relaxed">
            Good evening, I know it's after hours, but I wanted to ask if you
            have the new Mercedes C-Class in stock. What are the available trim
            levels and can I schedule a test drive?
          </p>
        </div>
      </div>

      <!-- AI Response -->
      <div class="flex items-start gap-3">
        <div
          class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center flex-shrink-0">
          <span class="text-white text-xs font-bold">AI</span>
        </div>
        <div
          class="flex-1 bg-gray-800 text-white rounded-2xl rounded-tl-sm p-4">
          <p class="text-sm leading-relaxed">
            Good evening, thank you for reaching out. Our office is currently
            closed, but we'll be happy to answer your questions during business
            hours. We'll contact you tomorrow to discuss the availability of the
            Mercedes C-Class and its options. Feel free to book a test drive
            through our website:
          </p>
          <div
            class="mt-3 inline-flex items-center gap-2 text-sm font-semibold">
            Book a ride ⚡
          </div>
        </div>
      </div>

      <!-- AI Follow-up -->
      <div class="flex items-start gap-3">
        <div
          class="w-10 h-10 rounded-full bg-gray-800 flex items-center justify-center flex-shrink-0">
          <span class="text-white text-xs font-bold">AI</span>
        </div>
        <div
          class="flex-1 bg-gray-800 text-white rounded-2xl rounded-tl-sm p-4">
          <p class="text-sm leading-relaxed">
            Thank you for your understanding, and we look forward to speaking
            with you tomorrow!
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
