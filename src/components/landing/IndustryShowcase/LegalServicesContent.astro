---
import { CheckCircle2 } from "@lucide/astro";

const benefits = [
  "Capture every potential client inquiry, even during court hours or after business hours.",
  "Qualify leads by gathering case details and urgency, prioritizing high-value opportunities.",
  "Reduce non-billable time spent on routine calls and appointment scheduling.",
];
---

<section class="max-w-7xl mx-auto px-4 py-12">
  <div class="grid lg:grid-cols-2 gap-12 items-start">
    <!-- Left Column - Benefits -->
    <div>
      <h2
        class="text-4xl md:text-5xl font-heading font-bold text-gray-900 mb-8">
        Legal Services
      </h2>

      <div class="space-y-4 mb-8">
        {
          benefits.map((benefit) => (
            <div class="flex gap-3 items-start">
              <CheckCircle2 class="w-6 h-6 text-primary shrink-0 mt-0.5" />
              <p class="text-lg text-gray-700 leading-relaxed">{benefit}</p>
            </div>
          ))
        }
      </div>

      <a
        href="/booking"
        class="inline-flex items-center gap-2 bg-white text-gray-900 px-6 py-3 rounded-lg font-semibold border-2 border-gray-900 hover:bg-gray-50 transition-colors">
        Get started today →
      </a>
    </div>

    <!-- Right Column - Call Transcript -->
    <div
      class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <!-- Header -->
      <div class="border-b border-gray-200 p-6">
        <h3 class="text-lg font-semibold text-gray-900 mb-4">
          Call transcript
        </h3>

        <div class="flex items-center justify-between">
          <div class="flex items-center gap-3">
            <div
              class="w-12 h-12 rounded-full bg-gray-200 flex items-center justify-center font-semibold text-gray-700">
              JD
            </div>
            <div>
              <div class="font-semibold text-gray-900">
                Call with Justin Doe
              </div>
              <div class="text-sm text-gray-500 flex items-center gap-2">
                <span>Today, 10:15AM</span>
                <span>📞</span>
                <span>Elons of A.I. answered</span>
              </div>
            </div>
          </div>
          <div class="text-sm text-gray-500">7:32</div>
        </div>
      </div>

      <!-- Transcript Content -->
      <div class="p-6 space-y-4 max-h-[400px] overflow-y-auto">
        <div class="flex gap-2 text-sm">
          <span class="text-gray-400 w-12 shrink-0">0:01</span>
          <div>
            <div class="font-semibold text-gray-900 mb-1">Elons of A.I.:</div>
            <p class="text-gray-700 leading-relaxed">
              Thank you for calling Smith & Associates Law Firm. This is an AI
              assistant. How may I help you today?
            </p>
          </div>
        </div>

        <div class="flex gap-2 text-sm">
          <span class="text-gray-400 w-12 shrink-0">0:06</span>
          <div>
            <div class="font-semibold text-gray-900 mb-1">Caller:</div>
            <p class="text-gray-700 leading-relaxed">
              Hi, I'm calling about a possible personal injury case. I was in a
              car accident last week.
            </p>
          </div>
        </div>

        <div class="flex gap-2 text-sm">
          <span class="text-gray-400 w-12 shrink-0">0:11</span>
          <div>
            <div class="font-semibold text-gray-900 mb-1">Elons of A.I.:</div>
            <p class="text-gray-700 leading-relaxed">
              I'm sorry to hear about your accident. I'd be happy to gather some
              initial information about your case. May I ask for your name?
            </p>
          </div>
        </div>

        <div class="flex gap-2 text-sm">
          <span class="text-gray-400 w-12 shrink-0">0:14</span>
          <div>
            <div class="font-semibold text-gray-900 mb-1">Caller:</div>
            <p class="text-gray-700 leading-relaxed">Sure, it's Justin Doe.</p>
          </div>
        </div>

        <div class="flex gap-2 text-sm">
          <span class="text-gray-400 w-12 shrink-0">0:20</span>
          <div>
            <div class="font-semibold text-gray-900 mb-1">Elons of A.I.:</div>
            <p class="text-gray-700 leading-relaxed">
              Thank you, Justin. Can you tell me a bit more about the accident?
              Where did it occur and what were the circumstances?
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
