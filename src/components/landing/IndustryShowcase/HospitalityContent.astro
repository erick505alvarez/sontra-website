---
import { CheckCircle2 } from "@lucide/astro";

const benefits = [
  "Provide instant responses to guest inquiries about amenities, availability, and local attractions.",
  "Increase direct bookings by offering 24/7 reservation assistance and answering pricing questions instantly.",
  "Enhance guest satisfaction by addressing concerns and special requests immediately, any time of day.",
];

const amenities = [
  { icon: "🏊", label: "Hotel swimming pool" },
  { icon: "🎮", label: "Hotel play zone room" },
  { icon: "♟️", label: "Hotel family board games" },
];
---

<section class="max-w-7xl mx-auto px-4 py-12">
  <div class="grid lg:grid-cols-2 gap-12 items-start">
    <!-- Left Column - Benefits -->
    <div>
      <h2
        class="text-4xl md:text-5xl font-heading font-bold text-gray-900 mb-8">
        Hospitality
      </h2>

      <div class="space-y-4 mb-8">
        {
          benefits.map((benefit) => (
            <div class="flex gap-3 items-start">
              <CheckCircle2 class="w-6 h-6 text-primary flex-shrink-0 mt-0.5" />
              <p class="text-lg text-gray-700 leading-relaxed">{benefit}</p>
            </div>
          ))
        }
      </div>

      <a
        href="/booking"
        class="inline-flex items-center gap-2 bg-white text-gray-900 px-6 py-3 rounded-lg font-semibold border-2 border-gray-900 hover:bg-gray-50 transition-colors">
        Get started today →
      </a>
    </div>

    <!-- Right Column - Guest Interaction -->
    <div
      class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <!-- Guest Message -->
      <div class="p-6 bg-blue-50">
        <div class="flex items-start gap-3">
          <div
            class="w-10 h-10 rounded-full bg-white flex items-center justify-center flex-shrink-0">
            <span class="text-sm">👤</span>
          </div>
          <div class="flex-1">
            <div class="font-semibold text-gray-900 mb-1">Guest</div>
            <p class="text-sm text-gray-800 leading-relaxed">
              Good morning, I'm looking for activities for my kids in the hotel.
              We'd like to spend time together without going outside.
            </p>
          </div>
        </div>
      </div>

      <!-- AI Response -->
      <div class="p-6 border-b border-gray-200">
        <div class="flex items-start gap-3">
          <div
            class="w-10 h-10 rounded-full bg-gray-100 flex items-center justify-center flex-shrink-0">
            <span class="text-xs font-semibold text-gray-700">💬</span>
          </div>
          <div class="flex-1">
            <div class="font-semibold text-gray-900 mb-2">Hotel AI</div>
            <p class="text-sm text-gray-800 leading-relaxed">
              Good morning! We have an indoor pool with a kids' area and a play
              zone with a jungle gym, board games, and a mini cinema. We also
              offer creative workshops like painting and cookie baking.
            </p>
          </div>
        </div>
      </div>

      <!-- Amenity Cards -->
      <div class="p-6">
        <div class="grid grid-cols-3 gap-4">
          {
            amenities.map((amenity) => (
              <div class="flex flex-col items-center justify-center p-4 bg-gray-50 rounded-xl border border-gray-200 hover:border-primary transition-colors cursor-pointer">
                <div class="text-3xl mb-2">{amenity.icon}</div>
                <div class="text-xs text-center text-gray-700 font-medium leading-tight">
                  {amenity.label}
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>
