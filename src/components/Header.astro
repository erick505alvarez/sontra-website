---
const { isHomePage } = Astro.props;

const p1 = "562";
const p2 = "342";
const p3 = "5281";
---

<header
  class="max-w-(--max-width) mx-auto px-6 py-8 flex items-center justify-between font-heading w-full">
  <a href="/">
    <div class="text-2xl font-heading font-bold text-primary">sontra.dev</div>
  </a>
  <div>
    {
      isHomePage ? (
        <a
          href="#contact"
          class="inline-block bg-primary text-white px-4 py-2 rounded-lg text-sm">
          Book a Demo
        </a>
      ) : (
        <a
          href="/"
          class="inline-block bg-primary text-white px-4 py-2 rounded-lg text-sm">
          Home
        </a>
      )
    }
  </div>
</header>
