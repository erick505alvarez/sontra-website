---
import { CheckCircle2 } from "@lucide/astro";

const benefits = [
  "Streamline patient scheduling with intelligent appointment booking and rescheduling.",
  "Handle insurance verification and pre-appointment paperwork collection automatically.",
  "Reduce no-shows with automated reminders and easy rescheduling options.",
];

const appointments = [
  {
    date: "26",
    day: "Sun",
    name: "Sarah M.",
    emoji: "😊",
    time: "10:00 - 11:00 AM",
    color: "bg-yellow-100",
  },
  {
    date: "27",
    day: "Mon",
    name: "Michael Torres",
    emoji: "👑",
    time: "2:00 - 3:00 PM",
    color: "bg-blue-100",
  },
  {
    date: "28",
    day: "Tue",
    name: "Emily Chen",
    emoji: "😊",
    time: "11:30 AM - 12:30 PM",
    color: "bg-purple-100",
  },
];
---

<section class="max-w-7xl mx-auto px-4 py-12">
  <div class="grid lg:grid-cols-2 gap-12 items-start">
    <!-- Left Column - Benefits -->
    <div>
      <h2
        class="text-4xl md:text-5xl font-heading font-bold text-gray-900 mb-8">
        Health Practices
      </h2>

      <div class="space-y-4 mb-8">
        {
          benefits.map((benefit) => (
            <div class="flex gap-3 items-start">
              <CheckCircle2 class="w-6 h-6 text-primary flex-shrink-0 mt-0.5" />
              <p class="text-lg text-gray-700 leading-relaxed">{benefit}</p>
            </div>
          ))
        }
      </div>

      <a
        href="/booking"
        class="inline-flex items-center gap-2 bg-white text-gray-900 px-6 py-3 rounded-lg font-semibold border-2 border-gray-900 hover:bg-gray-50 transition-colors">
        Get started today →
      </a>
    </div>

    <!-- Right Column - Calendar -->
    <div
      class="bg-white rounded-2xl border border-gray-200 shadow-sm overflow-hidden">
      <!-- Calendar Header -->
      <div class="grid grid-cols-3 border-b border-gray-200">
        <div class="px-4 py-3 text-center font-semibold text-gray-700">Sun</div>
        <div
          class="px-4 py-3 text-center font-semibold text-gray-700 border-x border-gray-200">
          Mon
        </div>
        <div class="px-4 py-3 text-center font-semibold text-gray-700">Tue</div>
      </div>

      <!-- Calendar Grid -->
      <div class="grid grid-cols-3">
        {
          appointments.slice(0, 3).map((apt, index) => (
            <div
              class={`
              p-4 min-h-[140px] relative
              ${index === 1 ? "border-x border-gray-200" : ""}
            `}>
              <div class="text-2xl font-light text-gray-400 mb-2">
                {apt.date}
              </div>
              <div class={`${apt.color} rounded-lg p-3`}>
                <div class="font-semibold text-sm text-gray-900 mb-1">
                  {apt.name}
                </div>
                <div class="text-xs text-gray-600 flex items-center gap-1">
                  <span>{apt.emoji}</span>
                  <span>{apt.time}</span>
                </div>
              </div>
            </div>
          ))
        }

        {/* Empty cells - second row */}
        <div class="p-4 min-h-[140px] border-t border-gray-200">
          <div class="text-2xl font-light text-gray-400">2</div>
        </div>
        <div class="p-4 min-h-[140px] border-t border-x border-gray-200">
          <div class="text-2xl font-light text-gray-400">3</div>
        </div>
        <div class="p-4 min-h-[140px] border-t border-gray-200">
          <div class="text-2xl font-light text-gray-400">4</div>
        </div>
      </div>
    </div>
  </div>
</section>
