---
// Src/components/TestForm.astro
import { Phone } from "@lucide/astro";
---

<section class="text-center">
  <h2 class="text-2xl md:text-3xl font-heading font-semibold mb-8">
    Test it for yourself...
  </h2>
  <form
    id="demo-form"
    class="flex flex-col lg:flex-row gap-4 mx-auto border border-primary rounded-lg bg-primary/5 p-10">
    <input
      type="text"
      name="first_name"
      placeholder="First Name"
      required
      minlength="2"
      class="test-form-input flex-1 border border-gray-300 rounded-lg px-4 py-3 text-base"
    />
    <input
      type="email"
      name="email"
      placeholder="Email"
      required
      class="test-form-input flex-1 border border-gray-300 rounded-lg px-4 py-3 text-base"
    />
    <input
      type="tel"
      name="phone"
      placeholder="19995554321"
      required
      pattern="^1?\d{10}$"
      class="test-form-input flex-1 border border-gray-300 rounded-lg px-4 py-3 text-base"
    />
    <!-- Honeypot field - hidden from real users -->
    <input
      type="text"
      name="website"
      class="absolute -left-[9999px] opacity-0 pointer-events-none"
      tabindex="-1"
      autocomplete="off"
    />
    <button
      type="submit"
      id="submit-btn"
      class="inline-flex items-center justify-center gap-2 bg-primary text-white px-6 py-3 rounded-lg font-semibold whitespace-nowrap hover:bg-primary/90 transition-colors disabled:opacity-50 disabled:cursor-not-allowed">
      <span id="btn-text">Test A.I. Voice Agent</span>
      <Phone class="w-5 h-5" id="phone-icon" />
      <svg
        id="spinner"
        class="hidden w-5 h-5 animate-spin"
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24">
        <circle
          class="opacity-25"
          cx="12"
          cy="12"
          r="10"
          stroke="currentColor"
          stroke-width="4">
        </circle>
        <path
          class="opacity-75"
          fill="currentColor"
          d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z">
        </path>
      </svg>
    </button>
  </form>
  <p id="form-message" class="mt-4 text-sm hidden"></p>
</section>

<script>
  function initDemoForm(): void {
    const form = document.getElementById("demo-form");
    const submitBtn = document.getElementById("submit-btn");
    const btnText = document.getElementById("btn-text");
    const phoneIcon = document.getElementById("phone-icon");
    const spinner = document.getElementById("spinner");
    const message = document.getElementById("form-message");

    // Type guard function
    function assertElements(
      elements: Record<string, HTMLElement | null>
    ): asserts elements is Record<string, HTMLElement> {
      for (const [name, el] of Object.entries(elements)) {
        if (!el) {
          throw new Error(`Required element "${name}" not found`);
        }
      }
    }

    // Validate all elements exist
    const elements = { form, submitBtn, btnText, phoneIcon, spinner, message };
    assertElements(elements);

    // Now TypeScript knows these are non-null
    const formEl = elements.form as HTMLFormElement;
    const buttonEl = elements.submitBtn as HTMLButtonElement;
    const btnTextEl = elements.btnText as HTMLElement;
    const phoneIconEl = elements.phoneIcon as HTMLElement;
    const spinnerEl = elements.spinner as HTMLElement;
    const messageEl = elements.message as HTMLElement;

    function formatPhone(phone: string): string {
      const digits = phone.replace(/\D/g, "");
      return digits.startsWith("1") ? `+${digits}` : `+1${digits}`;
    }

    function showMessage(text: string, isError = false): void {
      messageEl.textContent = text;
      messageEl.className = `mt-4 text-sm ${isError ? "text-red-600" : "text-green-600"}`;
      messageEl.classList.remove("hidden");
    }

    function hideMessage(): void {
      messageEl.classList.add("hidden");
    }

    function setLoading(loading: boolean): void {
      buttonEl.disabled = loading;
      btnTextEl.textContent = loading ? "Calling..." : "Test A.I. Voice Agent";
      phoneIconEl.classList.toggle("hidden", loading);
      spinnerEl.classList.toggle("hidden", !loading);
    }

    async function handleSubmit(e: Event): Promise<void> {
      e.preventDefault();

      const formData = new FormData(formEl);

      // Extract and type values
      const firstNameRaw = formData.get("first_name");
      const emailRaw = formData.get("email");
      const phoneRaw = formData.get("phone");
      const honeypotRaw = formData.get("website");

      const firstName =
        typeof firstNameRaw === "string" ? firstNameRaw.trim() : "";
      const email = typeof emailRaw === "string" ? emailRaw.trim() : "";
      const phone = formatPhone(typeof phoneRaw === "string" ? phoneRaw : "");
      const honeypot =
        typeof honeypotRaw === "string" ? honeypotRaw.trim() : "";

      // Client-side honeypot check (server also validates)
      if (honeypot) {
        showMessage("Something went wrong. Please try again.", true);
        return;
      }

      // Validation
      if (!firstName || firstName.length < 2) {
        showMessage("Please enter a valid name", true);
        return;
      }

      const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
      if (!emailRegex.test(email)) {
        showMessage("Please enter a valid email", true);
        return;
      }

      const phoneDigits = phone.replace(/\D/g, "");
      if (phoneDigits.length < 10 || phoneDigits.length > 11) {
        showMessage("Please enter a valid 10-digit phone number", true);
        return;
      }

      setLoading(true);
      hideMessage();

      try {
        const response = await fetch("/api/demo-call", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            first_name: firstName,
            email,
            phone,
            website: honeypot,
          }),
        });

        const result = await response.json();

        if (!response.ok || !result.success) {
          throw new Error(result.error || "Request failed");
        }

        showMessage("Great! You should receive a call within 30 seconds.");
        formEl.reset();
      } catch (error) {
        console.error("Form submission error:", error);
        const errorMessage =
          error instanceof Error ? error.message : "Something went wrong";
        showMessage(
          errorMessage === "Request failed"
            ? "Something went wrong. Please try again."
            : errorMessage,
          true
        );
      } finally {
        setLoading(false);
      }
    }

    formEl.addEventListener("submit", handleSubmit);
  }

  // Initialize when DOM is ready
  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", initDemoForm);
  } else {
    initDemoForm();
  }
</script>
