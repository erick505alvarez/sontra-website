<!-- CTA Component: AI Agent Dream Team -->
<section class="relative py-20 px-6 overflow-hidden bg-white">
  <div class="max-w-6xl mx-auto relative group">
    <div
      class="absolute inset-0 border-2 border-primary/20 [clip-path:polygon(20px_0%,_100%_0%,_100%_calc(100%-20px),_calc(100%-20px)_100%,_0%_100%,_0%_20px)] bg-gray-50">
      <div
        class="absolute inset-0 opacity-[0.03] [background-image:radial-gradient(var(--color-primary)_1px,transparent_1px)] [background-size:20px_20px]">
      </div>
    </div>

    <div class="relative z-10 py-16 px-8 md:px-20 text-center">
      <div
        class="inline-flex items-center gap-2 mb-8 px-3 py-1.5 bg-primary text-white text-xs uppercase tracking-wide font-bold rounded-md">
        <span class="relative flex h-2 w-2">
          <span
            class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75">
          </span>
          <span class="relative inline-flex rounded-full h-2 w-2 bg-white">
          </span>
        </span>
        System: Active Automation
      </div>

      <h2
        class="text-4xl md:text-5xl lg:text-6xl font-heading font-bold text-gray-900 leading-tight mb-6 tracking-tight">
        Build Your Dream Team <br />
        <span class="text-primary">with AI Agents</span>
      </h2>

      <p
        class="max-w-2xl mx-auto text-gray-600 text-lg md:text-xl leading-relaxed mb-12">
        Automate tasks effortlessly and scale your business without the yearly
        overhead operating costs of expanding your team.
      </p>

      <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
        <a
          href="https://cal.com/erick-alvarez-65ieku/30min"
          class="group relative w-full sm:w-auto px-10 py-4 bg-primary text-white font-semibold uppercase tracking-wide text-sm transition-all hover:-translate-y-1 active:translate-y-0 rounded-md hover:bg-primary/90">
          <span class="relative z-10 flex items-center justify-center gap-3">
            Get In Touch
            <svg
              xmlns="http://www.w3.org/2000/svg"
              width="20"
              height="20"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="group-hover:translate-x-1 transition-transform">
              <path d="M5 12h14m-7-7 7 7-7 7"></path>
            </svg>
          </span>
        </a>

        <a
          href="https://cal.com/erick-alvarez-65ieku/30min"
          class="w-full sm:w-auto px-10 py-4 border-2 border-gray-200 text-gray-900 font-semibold uppercase tracking-wide text-sm hover:bg-accent hover:text-white hover:border-accent transition-colors rounded-md">
          Try for Free
        </a>
      </div>
    </div>

    <div
      class="absolute top-0 right-0 w-8 h-8 border-t-4 border-r-4 border-primary">
    </div>
    <div
      class="absolute bottom-0 left-0 w-8 h-8 border-b-4 border-l-4 border-primary">
    </div>
  </div>
</section>

<style>
  /* Subtle grain texture overlay for depth */
  section::after {
    content: "";
    position: absolute;
    inset: 0;
    opacity: 0.02;
    pointer-events: none;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noiseFilter'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.65' numOctaves='3' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noiseFilter)'/%3E%3C/svg%3E");
  }
</style>
