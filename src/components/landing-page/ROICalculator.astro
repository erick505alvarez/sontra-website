---
/* ROI Calculator - Industrial Utility Design */
---

<section class="relative py-0 bg-canvas overflow-hidden">
  <div class="container mx-auto px-6 relative z-10">
    <div class="max-w-4xl mx-auto">
      <header class="mb-12 border-l-4 border-accent pl-6">
        <h2
          class="text-5xl md:text-7xl font-heading font-black uppercase tracking-tighter leading-none">
          Potential <span class="text-accent">Missed</span> ROI
        </h2>
        <p
          class="mt-4 text-gray-400 font-body max-w-xl text-lg uppercase tracking-widest leading-tight">
          Small numbers hide massive leaks. Even 3 missed calls daily could
          bleed 6-7 figures annually.
        </p>
      </header>

      <div class="grid lg:grid-cols-5 gap-0">
        <div
          class="lg:col-span-3 p-8 md:p-12 border-b lg:border-b-0 lg:border-r border-border-heavy">
          <div class="space-y-8" id="roi-form">
            <div class="group">
              <label
                class="block text-xs font-body uppercase text-accent mb-2 tracking-widest">
                Average Missed Calls / Day
              </label>
              <input
                type="number"
                id="missed-calls"
                value="3"
                class="w-full bg-transparent border-b-2 border-border-heavy py-4 text-3xl font-mono focus:outline-none focus:border-accent transition-colors"
              />
            </div>

            <div class="group">
              <label
                class="block text-xs font-body uppercase text-accent mb-2 tracking-widest">
                Average Value Per Lead ($)
              </label>
              <div class="relative">
                <span class="absolute top-1/2 -translate-y-[52%] text-3xl">
                  $
                </span>
                <input
                  type="number"
                  id="lead-value"
                  value="250"
                  class="pl-8 w-full bg-transparent border-b-2 border-border-heavy py-4 text-3xl font-mono focus:outline-none focus:border-accent transition-colors"
                />
              </div>
            </div>

            <div class="group">
              <label
                class="block text-xs font-mono uppercase text-accent mb-2 tracking-widest">
                03. Days Open / Month
              </label>
              <input
                type="number"
                id="days-open"
                value="26"
                class="w-full bg-transparent border-b-2 border-border-heavy py-4 text-3xl font-mono focus:outline-none focus:border-accent transition-colors"
              />
            </div>
          </div>
        </div>

        <div
          class="lg:col-span-2 p-8 md:p-12 flex flex-col justify-between bg-accent/5">
          <div>
            <span
              class="inline-block px-2 py-1 bg-accent text-[10px] font-bold uppercase mb-4">
              Estimated Monthly Leakage
            </span>
            <div class="flex items-baseline gap-2">
              <span class="text-4xl font-mono text-accent">$</span>
              <h3
                id="roi-result"
                class="text-6xl md:text-7xl font-mono font-bold tabular-nums tracking-tighter">
                19,500
              </h3>
            </div>
          </div>

          <div class="mt-12">
            <button
              class="group relative rounded-md w-full bg-primary text-white font-body font-bold uppercase py-5 px-8 transition-all duration-300 flex items-center justify-center gap-3 overflow-hidden cursor-pointer">
              <span class="relative z-10">
                Stop the Bleeding<br />Book Now
              </span>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 relative z-10 group-hover:translate-x-1 transition-transform"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="3"
                  d="M17 8l4 4m0 0l-4 4m4-4H3">
                </path>
              </svg>
            </button>
            <p
              class="text-[10px] font-mono text-gray-500 mt-4 text-center uppercase tracking-widest opacity-50">
              Generated by SONTRA.DEV ROI Engine v1.0
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const inputs = ["missed-calls", "lead-value", "days-open"];
  const resultDisplay = document.getElementById("roi-result");

  function calculate() {
    // 1. We cast the elements to HTMLInputElements so TS knows they have a '.value'
    // 2. Use optional chaining (?.) and default to "0" to handle potential nulls safely
    const getValue = (id: string) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      return parseFloat(el?.value || "0") || 0;
    };

    const missed = getValue("missed-calls");
    const value = getValue("lead-value");
    const days = getValue("days-open");

    const total = missed * value * days;

    if (resultDisplay) {
      resultDisplay.textContent = total.toLocaleString("en-US");
    }
  }

  inputs.forEach((id) => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener("input", calculate);
    }
  });
</script>

<style>
  /* Remove number input arrows */
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input[type="number"] {
    -moz-appearance: textfield;
  }
</style>
