---
/* ROI Calculator */
import { Phone } from "@lucide/astro";
---

<section class="relative py-0 bg-white overflow-hidden">
  <div class="mx-auto px-6 relative z-10">
    <header class="mb-12 flex flex-col items-center text-center">
      <h2
        class="text-4xl md:text-5xl font-heading font-bold tracking-tight leading-tight text-gray-900">
        Potential Missed ROI
      </h2>
      <p class="mt-4 text-gray-600 max-w-xl text-lg leading-relaxed">
        Small numbers hide massive leaks. Even 3 missed calls daily could bleed
        6-7 figures annually.
      </p>
    </header>

    <div
      class="grid lg:grid-cols-5 gap-0 border border-gray-200 rounded-2xl overflow-hidden">
      <div
        class="lg:col-span-3 p-8 md:p-12 border-b lg:border-b-0 lg:border-r border-gray-200 bg-white">
        <div class="space-y-8" id="roi-form">
          <div class="group">
            <label
              class="block text-sm font-semibold text-primary uppercase mb-2 tracking-wide">
              Average Missed Calls / Day
            </label>
            <input
              type="number"
              id="missed-calls"
              value="3"
              class="w-full bg-transparent border-b-2 border-gray-200 py-4 text-3xl font-heading font-bold focus:outline-none focus:border-primary transition-colors text-gray-900"
            />
          </div>

          <div class="group">
            <label
              class="block text-sm font-semibold text-primary uppercase mb-2 tracking-wide">
              Average Value Per Lead
            </label>
            <div class="relative">
              <span
                class="absolute top-1/2 -translate-y-[55%] text-3xl text-primary/60">
                $
              </span>
              <input
                type="number"
                id="lead-value"
                value="250"
                class="pl-8 w-full bg-transparent border-b-2 border-gray-200 py-4 text-3xl font-heading font-bold focus:outline-none focus:border-primary transition-colors text-gray-900"
              />
            </div>
          </div>

          <div class="group">
            <label
              class="block text-sm font-semibold text-primary uppercase mb-2 tracking-wide">
              Days Open / Month
            </label>
            <input
              type="number"
              id="days-open"
              value="26"
              class="w-full bg-transparent border-b-2 border-gray-200 py-4 text-3xl font-heading font-bold focus:outline-none focus:border-primary transition-colors text-gray-900"
            />
          </div>
        </div>
      </div>

      <div
        class="lg:col-span-2 p-8 md:p-12 flex flex-col justify-between bg-primary/5">
        <div class="flex flex-col items-center">
          <span
            class="inline-block px-3 py-1.5 bg-primary text-white text-xs font-bold uppercase rounded-md mb-4 tracking-wide">
            Estimated Monthly Leakage
          </span>
          <div class="flex items-baseline gap-2">
            <span class="text-4xl font-heading font-bold text-primary">$</span>
            <h3
              id="roi-result"
              class="text-5xl md:text-6xl font-heading font-bold tabular-nums tracking-tight text-gray-900">
              19,500
            </h3>
          </div>
        </div>

        <div class="mt-12">
          <a
            href="/booking"
            class="group relative rounded-lg w-full bg-primary text-white font-semibold py-2 px-4 transition-all duration-300 flex items-center justify-center gap-3 overflow-hidden cursor-pointer hover:bg-primary/90">
            <span class="relative z-10 text-center">Stop the Bleeding Now</span>
            <svg
              xmlns="http://www.w3.org/2000/svg"
              class="h-5 w-5 relative z-10 group-hover:translate-x-1 transition-transform"
              fill="none"
              viewBox="0 0 24 24"
              stroke="currentColor">
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M17 8l4 4m0 0l-4 4m4-4H3">
              </path>
            </svg>
          </a>
          <p
            class="text-xs text-gray-400 mt-4 text-center uppercase tracking-wide">
            Powered by sontra.dev
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  const inputs = ["missed-calls", "lead-value", "days-open"];
  const resultDisplay = document.getElementById("roi-result");

  function calculate() {
    const getValue = (id: string) => {
      const el = document.getElementById(id) as HTMLInputElement | null;
      return parseFloat(el?.value || "0") || 0;
    };

    const missed = getValue("missed-calls");
    const value = getValue("lead-value");
    const days = getValue("days-open");

    const total = missed * value * days;

    if (resultDisplay) {
      resultDisplay.textContent = total.toLocaleString("en-US");
    }
  }

  inputs.forEach((id) => {
    const el = document.getElementById(id);
    if (el) {
      el.addEventListener("input", calculate);
    }
  });
</script>

<style>
  /* Remove number input arrows */
  input::-webkit-outer-spin-button,
  input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }
  input[type="number"] {
    -moz-appearance: textfield;
  }
</style>
