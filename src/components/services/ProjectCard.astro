---
import Image from "astro/components/Image.astro";
const { title, subtitle, description, img, index } = Astro.props;
const isEven = index % 2 === 0;
---

<article class="bg-white rounded-lg grid grid-cols-1 md:grid-cols-2 gap-8">
  <!-- Card Image -->
  <Image
    src={img}
    alt={title}
    class:list={[
      "w-full object-cover rounded-xl",
      isEven ? "md:order-1" : "md:order-2",
    ]}
  />

  <!-- Card Description -->
  <div
    class:list={[
      "flex flex-col justify-center",
      isEven ? "md:order-2" : "md:order-1",
    ]}>
    <h3 class="font-semibold font-heading text-xl">{title}</h3>
    <p class="text-lg text-gray-600 mt-2 font-body">{subtitle}</p>
    <p class="mt-4 group-hover/card-hover:opacity-100 text-black">
      {description}
    </p>
  </div>
</article>
