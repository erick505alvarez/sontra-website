# Resend API for email sending
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_EMAIL_DOMAIN=yourdomain.com
TARGET_INBOX=your@email.com

# n8n webhook for demo call requests
N8N_DEMO_CALL_WEBHOOK=https://your-n8n-instance.com/webhook/xxx

# n8n configuration (not needed for sontra.dev)
# N8N_HOST=n8n.sontra.dev
# TIMEZONE=America/Los_Angeles